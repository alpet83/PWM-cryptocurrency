# Shared Windows/MSYS2 build defaults for build_project.cmd and test_project.cmd.

if [[ -n "${USERPROFILE:-}" ]]; then
  USERPROFILE_POSIX="$(cygpath -u "$USERPROFILE" 2>/dev/null || true)"
  if [[ -n "$USERPROFILE_POSIX" && -d "$USERPROFILE_POSIX/.cargo/bin" ]]; then
    export PATH="$USERPROFILE_POSIX/.cargo/bin:$PATH"
  fi
fi

export PATH="/ucrt64/bin:/mingw64/bin:$PATH"
export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$PROJECT_ROOT/target-codex}"
mkdir -p "$CARGO_TARGET_DIR/tmp"
export TMPDIR="$CARGO_TARGET_DIR/tmp"
export TMP="$TMPDIR"
export TEMP="$TMPDIR"
export CC="${CC:-/ucrt64/bin/gcc.exe}"
export CC_x86_64_pc_windows_gnu="${CC_x86_64_pc_windows_gnu:-/ucrt64/bin/gcc.exe}"
export LIBRARY_PATH="${LIBRARY_PATH:-/ucrt64/lib:/ucrt64/lib/gcc/x86_64-w64-mingw32/15.2.0}"

DLLTOOL_FLAG="-Cdlltool=/ucrt64/bin/dlltool.exe"
case " ${RUSTFLAGS:-} " in
  *" $DLLTOOL_FLAG "*) ;;
  *) export RUSTFLAGS="$DLLTOOL_FLAG${RUSTFLAGS:+ $RUSTFLAGS}" ;;
esac
